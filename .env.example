# Postgres credentials consumed by both the `postgres` service and the
# `app` service's DATABASE_URL (see docker-compose.yml and knexfile.js,
# which treats a single DATABASE_URL as the connection source of truth).
POSTGRES_USER=budgetpwa
POSTGRES_PASSWORD=change_me
POSTGRES_DB=budgetpwa

# Timezone used to derive a transaction's month_key from its date
# (server/services/months.js monthKeyFromDate). Defaults to
# America/Caracas if unset.
APP_TZ=America/Caracas

# Host port the app is published on (container always listens on 3000
# internally; PORT below only affects the container's own bind address).
APP_PORT=8080

# Port the Express server binds to inside the container. docker-compose.yml
# sets this explicitly to 3000; only relevant for non-compose local runs.
PORT=3000
